---
layout: null
permalink: /path-index.json
---
[{%- assign rows = "" | split: "" -%}
{%- for p in site.html_pages -%}
  {%- if p.layout == "redirect" or p.redirect_to or p.url == "/404.html" or p.url == "/404" -%}
  {%- else -%}
    {%- assign t = p.title | strip -%}
    {%- if t == "" -%}
      {%- if p.url == "/" -%}{%- assign t = "Yang Tan" -%}
      {%- elsif p.url == "/zh/" -%}{%- assign t = "谭扬" -%}
      {%- else -%}{%- assign t = p.seo_title | default: site.title -%}
      {%- endif -%}
    {%- endif -%}
    {%- capture row -%}{"u":{{ p.url | jsonify }},"t":{{ t | strip_html | truncate: 96 | jsonify }}}{%- endcapture -%}
    {%- assign rows = rows | push: row -%}
  {%- endif -%}
{%- endfor -%}
{%- for p in site.posts -%}
  {%- capture row -%}{"u":{{ p.url | jsonify }},"t":{{ p.title | strip_html | truncate: 96 | jsonify }}}{%- endcapture -%}
  {%- assign rows = rows | push: row -%}
{%- endfor -%}
{%- for row in rows -%}
{{ row }}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]
