---
layout: null
permalink: /search.json
---
[
{% assign bi_posts = site.posts | where: "categories", "BI" %}
{% assign ml_posts = site.posts | where: "categories", "ML" %}
{% assign cl_posts = site.posts | where: "categories", "CL" %}
{% assign cv_posts = site.posts | where: "categories", "CV" %}
{% assign ir_posts = site.posts | where: "categories", "IR" %}
{% assign os_posts = site.posts | where: "categories", "OS" %}
{% assign se_posts = site.posts | where: "categories", "SE" %}
{% assign posts = bi_posts | concat: ml_posts | concat: cl_posts | concat: cv_posts | concat: ir_posts | concat: os_posts | concat: se_posts %}
{% for post in posts %}
{% assign post_lang = post.lang | default: "en" %}
{% if post_lang == "zh-CN" or post_lang == "zh" %}{% assign post_lang = "zh" %}{% else %}{% assign post_lang = "en" %}{% endif %}
{% assign clean_cats = "" | split: "," %}
{% for cat in post.categories %}
  {% unless cat == "zh" or cat == "en" %}
    {% assign clean_cats = clean_cats | push: cat %}
  {% endunless %}
{% endfor %}
{
  "title": {{ post.title | jsonify }},
  "url": "{{ post.url | relative_url }}",
  "date": "{{ post.date | date_to_xmlschema }}",
  "lang": {{ post_lang | jsonify }},
  "categories": {{ clean_cats | jsonify }},
  "tags": {{ post.tags | jsonify }},
  "proceedings": {{ post.proceedings | jsonify }},
  "excerpt": {{ post.excerpt | strip_html | strip_newlines | jsonify }},
  "content": {{ post.content | strip_html | strip_newlines | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
