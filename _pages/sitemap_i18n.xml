---
permalink: /sitemap_i18n.xml
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% comment %}
  Priority bilingual sitemap for Search Console.
  Includes hubs + every project (and leaderboard when present) from projects.yml.
{% endcomment %}
{% comment %}
  lastmod strategy: hubs change when content changes → latest post date;
  project pages → their projects.yml date. Avoids site.time, which would
  refresh every URL on every build and make lastmod untrustworthy.
{% endcomment %}
{% assign latest_post = site.posts | sort: "date" | last %}
{% assign hub_lastmod = latest_post.date | date_to_xmlschema %}
{% assign pairs = "" | split: "" %}
{% capture pair_home %}/|/zh/|{{ hub_lastmod }}{% endcapture %}
{% capture pair_notes %}/notes/|/zh/notes/|{{ hub_lastmod }}{% endcapture %}
{% capture pair_timeline %}/timeline/|/zh/timeline/|{{ hub_lastmod }}{% endcapture %}
{% capture pair_project %}/projects/|/zh/projects/|{{ hub_lastmod }}{% endcapture %}
{% assign tcm_lastmod = site.data.tcm_catalog.updated_at | default: hub_lastmod %}
{% capture pair_tcm_models %}/projects/tcm/models/|/zh/projects/tcm/models/|{{ tcm_lastmod }}{% endcapture %}
{% capture pair_tcm_datasets %}/projects/tcm/datasets/|/zh/projects/tcm/datasets/|{{ tcm_lastmod }}{% endcapture %}
{% capture pair_tcm_surveys %}/projects/tcm/surveys/|/zh/projects/tcm/surveys/|{{ tcm_lastmod }}{% endcapture %}
{% assign pairs = pairs | push: pair_home | push: pair_notes | push: pair_timeline | push: pair_project %}
{% assign pairs = pairs | push: pair_tcm_models | push: pair_tcm_datasets | push: pair_tcm_surveys %}
{% comment %} Note-category landing pages (/notes/bi/ ↔ /zh/notes/bi/ etc.) {% endcomment %}
{% for c in site.data.note_categories %}
  {% assign cslug = c.id | downcase %}
  {% capture pair_c %}/notes/{{ cslug }}/|/zh/notes/{{ cslug }}/|{{ hub_lastmod }}{% endcapture %}
  {% assign pairs = pairs | push: pair_c %}
{% endfor %}
{% for p in site.data.projects %}
  {% if p.url and p.url_zh %}
    {% capture pair_p %}{{ p.url }}|{{ p.url_zh }}|{{ p.date | append: "-01" }}{% endcapture %}
    {% assign pairs = pairs | push: pair_p %}
  {% endif %}
{% endfor %}
{% for pair in pairs %}
  {% assign parts = pair | split: "|" %}
  {% assign en_path = parts[0] %}
  {% assign zh_path = parts[1] %}
  {% assign lastmod = parts[2] %}
  {% if en_path == '/projects/tcm/' or en_path == '/projects/tcm/models/' or en_path == '/projects/tcm/datasets/' or en_path == '/projects/tcm/surveys/' %}
    {% assign lastmod = tcm_lastmod %}
  {% endif %}
  <url>
    <loc>{{ site.url }}{{ en_path | xml_escape }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{% if en_path == '/' or en_path == '/projects/' %}1.0{% elsif en_path == '/projects/tcm/' %}0.95{% elsif en_path == '/notes/' or en_path == '/timeline/' %}0.8{% else %}0.7{% endif %}</priority>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ en_path | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ site.url }}{{ zh_path | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ en_path | xml_escape }}"/>
  </url>
  <url>
    <loc>{{ site.url }}{{ zh_path | xml_escape }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{% if zh_path == '/zh/' or zh_path == '/zh/projects/' %}1.0{% elsif zh_path == '/zh/projects/tcm/' %}0.95{% elsif zh_path == '/zh/notes/' or zh_path == '/zh/timeline/' %}0.8{% else %}0.7{% endif %}</priority>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ site.url }}{{ zh_path | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ en_path | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ en_path | xml_escape }}"/>
  </url>
{% endfor %}
{% comment %} Leaderboards currently exist in English only — list without fake zh pairs. {% endcomment %}
{% for p in site.data.projects %}
  {% if p.leaderboard %}
  <url>
    <loc>{{ site.url }}{{ p.leaderboard | xml_escape }}</loc>
    <lastmod>{{ p.date | append: "-01" }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.65</priority>
  </url>
  {% endif %}
{% endfor %}
</urlset>
