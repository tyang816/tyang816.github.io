---
permalink: /sitemap_i18n.xml
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% comment %}
  Priority bilingual sitemap for Search Console.
  Includes hubs + every project (and leaderboard when present) from projects.yml.
{% endcomment %}
{% assign pairs = "" | split: "" %}
{% capture pair_home %}/|/zh/{% endcapture %}
{% capture pair_notes %}/notes/|/zh/notes/{% endcapture %}
{% capture pair_timeline %}/timeline/|/zh/timeline/{% endcapture %}
{% capture pair_project %}/projects/|/zh/projects/{% endcapture %}
{% assign pairs = pairs | push: pair_home | push: pair_notes | push: pair_timeline | push: pair_project %}
{% for p in site.data.projects %}
  {% if p.url and p.url_zh %}
    {% capture pair_p %}{{ p.url }}|{{ p.url_zh }}{% endcapture %}
    {% assign pairs = pairs | push: pair_p %}
  {% endif %}
{% endfor %}
{% assign lastmod = site.time | date_to_xmlschema %}
{% for pair in pairs %}
  {% assign parts = pair | split: "|" %}
  {% assign en_path = parts[0] %}
  {% assign zh_path = parts[1] %}
  <url>
    <loc>{{ site.url }}{{ en_path }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{% if en_path == '/' or en_path == '/projects/' %}1.0{% elsif en_path == '/notes/' or en_path == '/timeline/' %}0.8{% else %}0.7{% endif %}</priority>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ en_path }}"/>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ site.url }}{{ zh_path }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ en_path }}"/>
  </url>
  <url>
    <loc>{{ site.url }}{{ zh_path }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{% if zh_path == '/zh/' or zh_path == '/zh/projects/' %}1.0{% elsif zh_path == '/zh/notes/' or zh_path == '/zh/timeline/' %}0.8{% else %}0.7{% endif %}</priority>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ site.url }}{{ zh_path }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ en_path }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ en_path }}"/>
  </url>
{% endfor %}
{% comment %} Leaderboards currently exist in English only — list without fake zh pairs. {% endcomment %}
{% for p in site.data.projects %}
  {% if p.leaderboard %}
  <url>
    <loc>{{ site.url }}{{ p.leaderboard }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.65</priority>
  </url>
  {% endif %}
{% endfor %}
</urlset>
